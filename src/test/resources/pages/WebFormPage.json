{
    "PAGE_URL": "url=#SITE_HOST#/selenium/web/web-form.html",
    "productName": "css=#my-text-id",
    "password": "css=input[name='my-password']",
    "description": "xpath=//textarea[@name='#KEYWORD#']",
    "brand": "css=select[name='my-select']",
    "model": "css=input[name='my-datalist']",
    "upload": "css=input[name='my-file']",
    "available": "css=input[id='my-check-1']",
    "freeDelivery": "css=input[id='my-check-2']",
    "freeReturn": "css=input[id='my-radio-1']",
    "paidReturn": "css=input[id='my-radio-2']",
    "color": "css=input[name='my-colors']",
    "deliveryDate": "css=input[name='my-date']",
    "weight": "css=input[name='my-range']",
    "submit": "image=src/test/resources/images/WebFormPage.submitButton.png"
}